{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProductionStatePath",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::prism-terraform-state-448079093324",
      "Condition": {
        "StringEquals": {
          "s3:prefix": [
            "production/terraform.tfstate",
            "production/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ReadWriteProductionState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::prism-terraform-state-448079093324/production/terraform.tfstate"
    },
    {
      "Sid": "ManageProductionStateLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::prism-terraform-state-448079093324/production/terraform.tfstate.tflock"
    }
  ]
}
